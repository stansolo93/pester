# pester.yaml — pester Vault Configuration
# Docs: https://github.com/stansolo93/pester

vault:
  name: "Acme"
  language: en                    # primary content language (en, ru, etc.)
  owner: "Your Name"

# Extraction keywords for action item detection
extraction:
  keywords:
    en: ["TODO", "action item", "deadline", "assigned to", "due by", "follow up"]
    # ru: ["нужно", "сделать", "дедлайн", "задача", "до"]
  patterns:
    - "- [ ] @{owner} — {desc} — by {date}"
    - "- [ ] @{owner}: {desc} (due: {date})"

# Search tuning (requires: pip install pester[search])
search:
  model: intfloat/multilingual-e5-base
  transcript_score_factor: 0.85

# Health check thresholds
health:
  journal_stale_days: 3
  decision_review_days: 60

